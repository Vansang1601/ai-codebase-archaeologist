# Database (Docker Compose overrides this automatically for containers)
DATABASE_URL=postgresql+psycopg://archaeologist:archaeologist@postgres:5432/archaeologist

# Public URL when deployed or exposed via tunnel (e.g. https://your-domain.com)
# Leave empty in local development to auto-detect from request headers
PUBLIC_URL=
CORS_ORIGINS=http://localhost:3000

# Authentication & Session Security
ENVIRONMENT=development
ALLOW_DEV_LOGIN=true
AUTH_SECRET=change-me-to-a-long-random-secret
# Rate limiting & Security controls
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
ALLOWED_EMAIL_DOMAINS=

# OAuth Login (GitHub & Google)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub App (optional - required only for private repositories)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Chatbot LLM API (OpenAI-compatible /chat/completions)
# Example for Google Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=your-gemini-api-key
#   LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public contact details displayed at /support (leave empty to show a placeholder)

SUPPORT_EMAIL=team@example.com

SUPPORT_PHONE=+84 900 000 000

SUPPORT_GITHUB=https://github.com/your-org/ai-codebase-archaeologist