# Core
DATABASE_URL=postgresql+psycopg://archaeologist:archaeologist@postgres:5432/archaeologist
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Authentication (required for M2+)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
BACKEND_INTERNAL_SECRET=

# OAuth - Login only (GitHub)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# OAuth - Login only (Google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub App - Repository connection (separate from login OAuth)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Repository analysis limits
REPO_WORKDIR=/workspace/repos
MAX_REPO_FILES=5000
MAX_FILE_BYTES=262144
MAX_HISTORY_COMMITS=200
MAX_CLONE_SECONDS=120

# Optional OpenAI-compatible LLM endpoint.
# Leave blank to run in evidence-only mode (no cloud LLM required).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
